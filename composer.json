{
    "name": "anton-am/ratchet",
    "type": "library",
    "description": "PHP WebSocket library (Personal fork: PHP 8.4-safe branch 0.4.x)",
    "keywords": ["WebSockets", "Server", "Ratchet", "Sockets", "WebSocket"],
    "homepage": "http://socketo.me",
    "license": "MIT",
    "authors": [
        {
            "name": "Chris Boden",
            "email": "cboden@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Matt Bonneau",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Anton-Am/Ratchet/issues",
        "source": "https://github.com/Anton-Am/Ratchet"
    },
    "replace": {
        "cboden/ratchet": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Ratchet\\": "src/Ratchet"
        }
    },
    "require": {
        "php": ">=8.0",
        "ratchet/rfc6455": "^0.4.1",
        "react/socket": "^1.0",
        "react/event-loop": "^1.0",
        "guzzlehttp/psr7": "^2.12.3 || ^3.0",
        "symfony/http-foundation": "^5.4 || ^6.4 || ^7.0 || ^8.0",
        "symfony/routing": "^5.4 || ^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "scripts": {
        "test": "phpunit",
        "check-deprecations": "./docker/app check-deprecations",
        "cs": "phpcs",
        "stan": "phpstan analyse",
        "check": [
            "@check-deprecations",
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
